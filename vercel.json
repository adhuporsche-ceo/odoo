{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "functions": {
    "api/[...route].js": {
      "includeFiles": "config/schema.sql",
      "maxDuration": 60
    },
    "api/socket-io.js": {
      "includeFiles": "config/schema.sql",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/public/$1"
    }
  ]
}
